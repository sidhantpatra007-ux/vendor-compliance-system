# Copy to python-service/.env and fill in. NEVER commit the real .env.
# Variable names below are exactly the ones read by config.py and the modules.

# --- Required: the service refuses to start without these -------------------
COMPANIES_HOUSE_API_KEY=
GEMINI_API_KEY=
# Full Postgres URI (Supabase pooler or any Postgres), password included.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Security: set ALL of these (see SECURITY.md) ---------------------------
# Shared secret that n8n sends as the `x-internal-api-key` header.
# WARNING: if this is empty, the internal API endpoints are NOT authenticated.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=
# Dashboard login. Set both or neither; use a long random SESSION_SECRET.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Set to true when the dashboard is served over HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Companies House streaming (optional) -----------------------------------
# Needs a SEPARATE Streaming API key from the Companies House Developer Hub.
COMPANIES_HOUSE_STREAM_ENABLED=false
COMPANIES_HOUSE_STREAM_API_KEY=

# --- Internal services ------------------------------------------------------
SANCTIONS_SERVICE_URL=http://sanctions-service:8001
# Public base URL used to build vendor questionnaire links in e-mails.
# Required before the "send questionnaire" action will work.
QUESTIONNAIRE_BASE_URL=

# --- Alerting & retention (defaults shown) ----------------------------------
ALERT_SCORE_DROP_THRESHOLD=-5
ALERT_SLA_HOURS=24
AUDIT_RETENTION_DAYS=365

# --- Advanced (leave unset unless you know you need them) -------------------
# Schema is managed by Alembic (alembic upgrade head). Only enable this for a
# throwaway dev database; it makes the app call create_all() on startup.
# ALLOW_LEGACY_SCHEMA_CREATE=false
# Where rendered filing pages are stored inside the container.
# EVIDENCE_DIR=/app/evidence
