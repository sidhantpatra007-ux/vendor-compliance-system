      "credentials": {
        "httpHeaderAuth": {
          "name": "Header Auth account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const intake = $('Remove empty answers').item.json;\nconst record = { ...intake, ...$json };\nconst factors = Array.isArray(record.factors) ? record.factors : [];\nconst text = (value) => String(value ?? '').trim().toLowerCase();\nconst yes = (value) => value === true || ['true', 'yes'].includes(text(value));\nconst highImpact = ['high', 'critical'].includes(text(record.supplier_criticality));\nconst critical = factors.find((factor) => factor?.severity === 'critical');\nconst reasons = [];\nif (record.duplicate) reasons.push('An existing company record was refreshed; no duplicate was created');\nif (record.recommend_manual_review) reasons.push('Automated screening requires human review');\nif (highImpact) reasons.push(`Supplier criticality: ${record.supplier_criticality}`);\nif (yes(record.access_to_client_systems_or_data)) reasons.push('Company will access client systems or data');\nif (yes(record.processes_personal_data)) reasons.push('Company will process personal data');\nif (yes(record.uses_subcontractors)) reasons.push('Company uses subcontractors');\nlet route = 'STANDARD_REVIEW';\nlet severity = 'low';\nif (critical) { route = 'BLOCKED'; severity = 'critical'; reasons.unshift(critical.description || 'Critical screening condition detected'); }\nelse if (reasons.length) { route = 'REVIEW_REQUIRED'; severity = 'medium'; }\nreturn { json: { ...record, route, onboarding_severity: severity, onboarding_reasons: reasons } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
