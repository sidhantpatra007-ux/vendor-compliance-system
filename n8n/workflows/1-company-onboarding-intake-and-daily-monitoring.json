    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => {\n  const form = $json;\n  const pick = (...names) => {\n    const key = Object.keys(form).find((candidate) => names.some((name) => candidate.trim().toLowerCase() === name.trim().toLowerCase()));\n    return key ? form[key] : undefined;\n  };\n  const declaration = pick(\"Supplier declaration\", \"Supplier declaration accepted\");\n  return {\n    company_number: pick(\"Company number\"),\n    display_name: pick(\"Legal company name\"),\n    trading_name: pick(\"Trading name ( if different)\"),\n    vendor_category: pick(\"Supplier category\"),\n    goods_or_services: pick(\"Goods or services provided ( Short description)\"),\n    supplier_criticality: pick(\"Client-assessed supplier criticality\"),\n    annual_spend_band: pick(\"Estimated annual spend\"),\n    access_to_client_systems_or_data: pick(\"Access to client systems or data\"),\n    processes_personal_data: pick(\"Processes personal data\"),\n    delivery_countries: pick(\"Delivery countries\"),\n    uses_subcontractors: pick(\"Uses subcontractors\"),\n    supplier_declaration_accepted: declaration === true || String(declaration ?? \"\").trim().toLowerCase() === \"true\",\n    contact_name: pick(\"Primary contact name\"),\n    contact_email: pick(\"Primary contact email\"),\n    address_street: pick(\"Registered street address\"),\n    address_city: pick(\"Registered city\"),\n    address_postcode: pick(\"Registered postcode\"),\n    company_website: pick(\"Company website\")\n  };\n})() }}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1392,
        144
      ],
      "id": "665d2efe-fa2c-4130-96e6-54a5f7eacdea",
      "name": "Map existing intake fields"
    },
    {
      "parameters": {
        "jsCode": "const clean = {};\nfor (const [key, value] of Object.entries($json)) {\n  if (value === undefined || value === null) continue;\n  if (typeof value === 'string') { const trimmed = value.trim(); if (trimmed) clean[key] = trimmed; }\n  else clean[key] = value;\n}\nreturn { json: clean };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1184,
        144
      ],
      "id": "73db0c2f-6727-44da-8056-6fd0cc56c48c",
      "name": "Remove empty answers"
    },
