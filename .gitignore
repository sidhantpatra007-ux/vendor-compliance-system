# =============================================================================
# Secrets & local configuration  (NEVER commit these)
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# =============================================================================
# Runtime data & state  (generated by docker compose / the app, not source)
# =============================================================================
# n8n: holds the encryption key (config), the SQLite DB with stored credentials,
# and execution history. Treat as a secret store.
/n8n_data/
# Cached UK Sanctions List snapshot (re-downloaded automatically)
/sanctions-data/
# Rendered filing pages (may contain real company data)
/evidence/
# Local SQLite files / app data volume
/python-service/data/
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-journal

# Raw (unsanitised) n8n exports. Run scripts/sanitize_n8n_export.py and commit
# the cleaned output in n8n/workflows/ instead.
/n8n/raw/

# Logs and scratch output
*.log
log.txt
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archives / backups (e.g. "project - Copy.zip")
*.zip
*.bak
*.orig
*.rej

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# =============================================================================
# Node / Vite  (vendor-dashboard)
# =============================================================================
node_modules/
.vite/
*.tsbuildinfo
coverage/

# =============================================================================
# Editors & OS
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
